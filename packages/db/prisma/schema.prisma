generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  username String @unique

  rating   UserRating[]
  gameMember GameMember[]

  sender   Friends[] @relation("sender")
  receiver Friends[] @relation("receiver")

  answers QuestionAnswer[]
}

model Game {
  id        String   @id @default(uuid())
  timelimit Int
  startedAt DateTime
  endsAt    DateTime

  status GameStatus
  gameMember GameMember[]
  questions  Question[]
  answers    QuestionAnswer[]
}

model GameMember {
  id String @id @default(uuid())

  status GameMemberStatus

  gameId String
  userId String

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
}

model UserRating {
  id String @id @default(uuid())

  userId String
  rating Int

  user User @relation(fields: [userId], references: [id])
}

model Friends {
  id String @id @default(uuid())

  status FriendsStatus @default(pending)

  receiverId String
  senderId   String

  receiver User @relation("receiver", fields: [receiverId], references: [id])
  sender   User @relation("sender", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
}

model Question {
  id String @id @default(uuid())

  gameId String

  systemAnswer Int
  operation1   Int
  operation2   Int
  sign         QuestionSign

  game    Game             @relation(fields: [gameId], references: [id])
  answers QuestionAnswer[]
}

model QuestionAnswer {
  id String @id @default(uuid())

  questionId String
  gameId     String
  userId     String

  answer Int

  question Question @relation(fields: [questionId], references: [id])
  game     Game     @relation(fields: [gameId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

enum FriendsStatus {
  accepted
  rejected
  pending
}

enum QuestionSign {
  PLUS
  MINUS
  DIVIDE
  MULTIPLICATION
}


enum GameMemberStatus {
  WON
  LOSS

}

enum GameStatus {
  RUNNING
  SEARCHING_FOR_PLAYER
  ENDED

}